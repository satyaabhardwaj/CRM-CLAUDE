# Hosted preparation is authorized for the named CRM projects only.
# Use separate Preview/Production values. Production cutover requires START CUTOVER.
CRM_ENV=production
# Generate a unique UUID per hosted environment; never reuse a development/preview realm.
CRM_AUTH_REALM=REPLACE_WITH_UNIQUE_UUID
CRM_ORIGIN=https://YOUR_CRM_DOMAIN
DATABASE_URL=postgresql+psycopg://APP_ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Direct/session URL used by a separate controlled migration job, never browser code.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CRM_STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_KEY
SUPABASE_UPLOADS_BUCKET=crm-uploads
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
# No SMTP variables: factory emails are disabled in the API.

# Account recovery: keep disabled until mailbox, migrations and enrollment are authorized.
CRM_RECOVERY_ENABLED=0
RECOVERY_SMTP_HOST=
RECOVERY_SMTP_PORT=587
RECOVERY_SMTP_USER=
RECOVERY_SMTP_PASSWORD=
RECOVERY_MAIL_FROM=

# MFA seed encryption: unique Fernet key per environment, server-only.
# Keep unset until migrations and activation are explicitly authorized.
CRM_MFA_ENCRYPTION_KEY=
