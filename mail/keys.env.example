# Copy this file to keys.env (same folder) and fill it in. Keep keys.env on this laptop only.
# The sending mailbox. For Zoho Mail in India: smtp.zoho.in, port 587. For Gmail: smtp.gmail.com, port 587 (needs an app password).
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Who is told when an order moves to the Factory. Several addresses: separate with commas.
FACTORY_EMAIL=
# TEST MODE: while this is filled in, every email goes here and nowhere else.
MAIL_TEST_EMAIL=info@mymagppie.com
