# Preparation only. No cloud project or deployment is authorized.
# Set server variables in Vercel only after explicit future deployment approval.
CRM_ENV=production
CRM_ORIGIN=https://YOUR_CRM_DOMAIN
DATABASE_URL=postgresql+psycopg://APP_ROLE.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Direct/session URL used by a separate controlled migration job, never browser code.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CRM_STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_KEY
SUPABASE_UPLOADS_BUCKET=crm-uploads
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
# No SMTP variables: factory emails are disabled in the API.
