# Copy this file to keys.env (same folder) and fill it in. Keep keys.env on this laptop only.
#
# 1. Go to https://api-console.zoho.in  ->  Add Client  ->  Self Client.
# 2. Copy the Client ID and Client Secret below.
# 3. In the Self Client, "Generate Code" with this scope:   ZohoSign.documents.ALL
#    Paste the code to Claude's helper step, or ask for help turning it into a refresh token.
ZOHO_SIGN_CLIENT_ID=
ZOHO_SIGN_CLIENT_SECRET=
ZOHO_SIGN_REFRESH_TOKEN=
# Your Zoho data centre: in (India), com, eu, com.au
ZOHO_DC=in

# TEST MODE. While this is filled in, every document goes to this address and never to the client.
# Put your own email here first. Clear it only when you are ready to send to real clients.
SIGN_TEST_EMAIL=

# Optional: the Magppie person who signs after the client. Leave empty for client only.
SIGN_MAGPPIE_NAME=
SIGN_MAGPPIE_EMAIL=
