# Copy to ignored .env on the staging host. No local/demo credentials.
CRM_IMAGE=magppie-crm:REPLACE_WITH_TESTED_RELEASE
CRM_HOST=crm-staging.example.com
CRM_ORIGIN=https://crm-staging.example.com
DATABASE_URL=postgresql+psycopg://APP_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/STAGING_DB?sslmode=verify-full&sslrootcert=/PATH/TO/CA.pem
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:URL_ENCODED_PASSWORD@DB_HOST:5432/STAGING_DB?sslmode=verify-full&sslrootcert=/PATH/TO/CA.pem
# Mount the provider CA certificate read-only at the paths above.
