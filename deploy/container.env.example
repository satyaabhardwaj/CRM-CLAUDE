# Server-only template. Copy privately; never commit actual values.
CRM_ENV=production
CRM_ORIGIN=https://CRM_DOMAIN
DATABASE_URL=postgresql+psycopg://APP_ROLE:PASSWORD@DB_HOST:5432/postgres?sslmode=require
CRM_STORAGE_BACKEND=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_KEY
SUPABASE_UPLOADS_BUCKET=crm-uploads
# Local Docker override only: CRM_ENV=development, CRM_ORIGIN=http://127.0.0.1:4302,
# DATABASE_URL host=supabase_db_magppie-crm-dev port=5432,
# SUPABASE_URL=http://127.0.0.1:56321 (browser-facing),
# SUPABASE_INTERNAL_URL=http://supabase_kong_magppie-crm-dev:8000 (container-facing).

# Sliding sessions (optional): sign-out after this many idle minutes, and at most this many hours after sign-in.
# CRM_SESSION_IDLE_MINUTES=240
# CRM_SESSION_MAX_HOURS=12
