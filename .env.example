# Copy to .env.local only for LOCAL development. scripts/configure_supabase_local.py
# captures the actual CLI values into ignored .local/supabase.env without printing keys.
CRM_ENV=development
CRM_ORIGIN=http://127.0.0.1:4301
DATABASE_URL=postgresql+psycopg://postgres:LOCAL_PASSWORD@127.0.0.1:56322/postgres
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:LOCAL_PASSWORD@127.0.0.1:56322/postgres
CRM_STORAGE_BACKEND=supabase
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=LOCAL_SERVER_KEY
SUPABASE_UPLOADS_BUCKET=crm-uploads
# Optional existing read-only Zoho integration variables:
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
